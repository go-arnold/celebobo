# Local stack (./deploy/local.sh): production settings, local Postgres/Redis, emails caught by Mailpit.
# Works as-is; fill CLOUDINARY_* / GEMINI_API_KEY only to test image uploads or the real assistant.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=local-only-not-secret-0b6f3c1d2e9a4f8b7c6d5e4f3a2b1c0d
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Kinshasa
LOG_LEVEL=INFO
LOG_JSON=false

# plain http locally: no https redirect, cookies without the Secure flag
SECURE_SSL_REDIRECT=false
COOKIE_SECURE=false

DATABASE_URL=postgres://celebobo:celebobo@postgres:5432/celebobo
DATABASE_POOLER=false
REDIS_CACHE_URL=redis://redis:6379/0
REDIS_BROKER_URL=redis://redis:6379/1
REDIS_CHANNELS_URL=redis://redis:6379/2

# The site is opened through nginx; the Next dev server (npm run dev, port 3000) sits behind it.
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3000
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
COOKIE_SAMESITE=Lax
PROXY_COUNT=1

# Next server-side rendering: the same secrets go in the frontend env (SSR_SHARED_SECRET, REVALIDATE_SECRET).
# The Next server reaches Django at http://api:8000 (container) or http://localhost:8080 (npm run dev).
SSR_SHARED_SECRET=local-ssr-secret
DJANGO_INTERNAL_HOSTS=api
FRONTEND_REVALIDATE_URL=http://nginx/revalidate
FRONTEND_REVALIDATE_SECRET=local-revalidate-secret

ACCOUNT_EMAIL_VERIFICATION=mandatory
EMAIL_URL=smtp://mailpit:1025
# ./deploy/local.sh e2e may empty this database
E2E_SEED_ALLOWED=true
DEFAULT_FROM_EMAIL=Celebobo <no-reply@celebobo.test>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8080/connexion/google

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=celebobo-local

CORE_EVENTS_DISPATCHER=celery
CORE_METRICS_BACKEND=log
DOCUMENTS_ROOT=/app/var/documents

ASSISTANT_PROVIDER=offline
GEMINI_API_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

WEB_CONCURRENCY=2
CELERY_CONCURRENCY=1
