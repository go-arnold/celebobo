# Production (./deploy/prod.sh). One domain serves the site and the API: https://DOMAIN and https://DOMAIN/api/v1/
# Copy to deploy/.env.prod (never committed) and fill every empty value.

# --- Compose ------------------------------------------------------------------
DOMAIN=celebobo.com
# other names on the same certificate, space separated (e.g. www.celebobo.com)
EXTRA_DOMAINS=www.celebobo.com
LETSENCRYPT_EMAIL=
# run the Next.js frontend on this server; leave empty if it stays on Vercel
COMPOSE_PROFILES=frontend

# --- Django ---------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=celebobo.com,www.celebobo.com
TIME_ZONE=Africa/Lubumbashi
LOG_LEVEL=INFO
LOG_JSON=true
SECURE_SSL_REDIRECT=true

# Postgres and Redis on this server (recommended: a query costs ~0.2 ms instead of a round trip to
# another data centre). Add "data" to COMPOSE_PROFILES, generate both passwords with
# python3 -c "import secrets; print(secrets.token_hex(24))", and use the local URLs below.
#   DATABASE_URL=postgres://celebobo:POSTGRES_PASSWORD@postgres:5432/celebobo with DATABASE_POOLER=false
#   REDIS_CACHE_URL=redis://:REDIS_PASSWORD@redis:6379/0 (/1 broker, /2 channels)
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# nightly dumps (deploy/backups by default) and how many days to keep
BACKUP_DIR=./backups
BACKUP_DAYS=7
# only while moving from Supabase (./deploy/prod.sh import-db): its session pooler, port 5432
SOURCE_DATABASE_URL=

# Or hosted: Supabase transaction pooler (port 6543) with DATABASE_POOLER=true
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_POOLER=true

# Aiven (TLS)
REDIS_CACHE_URL=rediss://default:PASSWORD@HOST.aivencloud.com:PORT/0
REDIS_BROKER_URL=rediss://default:PASSWORD@HOST.aivencloud.com:PORT/1?ssl_cert_reqs=required
REDIS_CHANNELS_URL=rediss://default:PASSWORD@HOST.aivencloud.com:PORT/2

# Same origin: no cross-site cookies needed
FRONTEND_URL=https://celebobo.com
CORS_ALLOWED_ORIGINS=https://celebobo.com,https://www.celebobo.com
CSRF_TRUSTED_ORIGINS=https://celebobo.com,https://www.celebobo.com
WEBSOCKET_ALLOWED_ORIGINS=https://celebobo.com,https://www.celebobo.com
COOKIE_SAMESITE=Lax
# nginx is the only proxy in front of Django (add 1 more behind Cloudflare's proxy)
PROXY_COUNT=1

# Next server-side rendering: the frontend container calls http://api:8000 directly (sending
# X-Forwarded-Proto: https) with X-SSR-Token, and receives cache revalidations from the worker.
# Generate each secret with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SSR_SHARED_SECRET=
DJANGO_INTERNAL_HOSTS=api
FRONTEND_REVALIDATE_URL=http://frontend:3000/revalidate
FRONTEND_REVALIDATE_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

ACCOUNT_EMAIL_VERIFICATION=mandatory
EMAIL_URL=smtp+tls://USER%40gmail.com:APP_PASSWORD@smtp.gmail.com:587
DEFAULT_FROM_EMAIL=Celebobo <no-reply@celebobo.com>

# also passed to the frontend build (same names)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://celebobo.com/connexion/google

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=celebobo

CORE_EVENTS_DISPATCHER=celery
CORE_METRICS_BACKEND=log
CORE_PROBLEM_BASE_URI=https://celebobo.com/api/problems

DOCUMENTS_ROOT=/app/var/documents
DOCUMENTS_COMPANY_NAME=Celebobo
DOCUMENTS_COMPANY_ADDRESS=Bukavu · Goma, RD Congo
DOCUMENTS_COMPANY_CONTACT=support@celebobo.com

ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@celebobo.com

# --- Sizing (2 vCPU / 4 GB server) ----------------------------------------------
WEB_CONCURRENCY=3
CELERY_CONCURRENCY=2
