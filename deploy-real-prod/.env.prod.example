DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.celebobo.cd
TIME_ZONE=Africa/Kinshasa
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_POOLER=true
DATABASE_CONN_MAX_AGE=0

REDIS_CACHE_URL=rediss://default:PASSWORD@HOST.aivencloud.com:PORT/0
REDIS_BROKER_URL=rediss://default:PASSWORD@HOST.aivencloud.com:PORT/1?ssl_cert_reqs=required
REDIS_CHANNELS_URL=rediss://default:PASSWORD@HOST.aivencloud.com:PORT/2

FRONTEND_URL=https://celebobo.cd
CORS_ALLOWED_ORIGINS=https://celebobo.cd
CSRF_TRUSTED_ORIGINS=https://celebobo.cd
WEBSOCKET_ALLOWED_ORIGINS=https://celebobo.cd
SESSION_COOKIE_DOMAIN=.celebobo.cd
CSRF_COOKIE_DOMAIN=.celebobo.cd
COOKIE_SAMESITE=Lax
JWT_AUTH_COOKIE_DOMAIN=.celebobo.cd
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
SECURE_SSL_REDIRECT=true
AXES_PROXY_COUNT=1
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

ACCOUNT_EMAIL_VERIFICATION=mandatory
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://celebobo.cd/auth/google/callback

EMAIL_URL=smtp+tls://USER:PASSWORD@smtp.example.com:587
DEFAULT_FROM_EMAIL=Celebobo <no-reply@celebobo.cd>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=celebobo

CORE_EVENTS_DISPATCHER=celery
CORE_METRICS_BACKEND=log
CORE_PROBLEM_BASE_URI=https://api.celebobo.cd/problems

CATALOG_SEARCH_ENGINE=postgres
CATALOG_SEARCH_INDEX=postgres
ORDERS_FREE_SHIPPING_THRESHOLD=199.00
ORDERS_FLAT_SHIPPING_FEE=2.98

DOCUMENTS_ROOT=/app/var/documents
DOCUMENTS_COMPANY_NAME=Celebobo
DOCUMENTS_COMPANY_ADDRESS=Kinshasa, RD Congo
DOCUMENTS_COMPANY_CONTACT=contact@celebobo.cd
DOCUMENTS_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=365
ANALYTICS_REFRESH_SECONDS=600

ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
ASSISTANT_DAILY_MESSAGES=2000

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@celebobo.cd

WEB_CONCURRENCY=2
CELERY_DEFAULT_CONCURRENCY=2
CELERY_AI_CONCURRENCY=2
CELERY_EXPORTS_CONCURRENCY=1
